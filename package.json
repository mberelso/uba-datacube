{
  "name": "uba-datacube",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "og-image": "node scripts/generate-og-image.cjs",
    "build": "npx tsx scripts/generate-sitemap.ts && tsc -b && vite build && npx tsx scripts/prerender.ts && node -e \"const fs=require('fs'); if(fs.readdirSync('dist/assets').some(f=>fs.readFileSync('dist/assets/'+f,'utf8').includes('AIzaSy'))){console.error('❌ API Key im Bundle!'); process.exit(1);}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "npx tsx scripts/test-sdmx.ts",
    "preview": "vite preview",
    "generate-descriptions": "npx tsx scripts/generate-descriptions.ts",
    "fetch-metadata": "npx tsx scripts/fetch-metadata.ts",
    "generate-backgrounds": "npx tsx scripts/generate-backgrounds.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  }
}
